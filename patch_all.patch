+                            parcels: list[str]) -> list[str]:
+    """同 _place_handover_g，但已经安排了地面交付的票不再重复安排（残段底板里可能已有）."""
+    already: set[str] = set()
+    for v in plan.visits.values():
+        already.update(v.ground)
+    todo = [p for p in parcels if p not in already]
