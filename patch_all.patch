     holders: dict[str, str] = {}
     drone_of: dict[str, str] = {}
+    handed: dict[str, str] = {}      # 已回收并交接给回收车、尚未地送的票 → 回收车
     for s in new.sorties.values():
         if s.started:
             for p in s.air + s.handover:
                 drone_of[p] = s.drone
     # 原计划中在飞（started）的航次：其机上票在快照时确实在机上
+    # 修复（第一轮顺带）：只有"此刻仍在飞"的残段，机上票才算无人机保管；
